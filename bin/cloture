#!/usr/bin/env bash
# cloture -- what a session is about to leave behind, and who it lands on.
#
# KIND: personal
#
# The `/cloture` command used to carry these checks as prose, and prose let a
# close say "documented exception" forever: on 2026-09-07 a close reported 29
# leftover branches that way, twenty of which needed no judgement at all
# (hf7y/realisateur#1086). A sentence in a conversation is not a finding. This
# is the same routine with the judgement taken out of the narration and put in
# a exit code, so the close either comes back CLEAN or it comes back with rows.
#
# THREE THINGS IT LOOKS FOR, named by Zach 2026-09-07:
#   raised but not filed  -- a defect the session named with no issue or PR
#   layered not replaced  -- a surface added while the ones it duplicates stay
#   built but not wired   -- a thing that exists and nothing reaches
#
# IT IS A DETECTOR, NOT A FIXER. It writes nothing, files nothing and takes
# nothing down. The caller acts on the rows and runs it again; a close is done
# when a pass is CLEAN, which is what makes the routine idempotent rather than
# a single sweep that reports whatever it happened to see first.
#
# NO CLONE REQUIRED. Every path it reads is either the installed verb build,
# a home directory, or the repository the caller is already standing in. It
# must keep working the day no project clone exists on this host, which is the
# acceptance test for anything installed here at all.
#
# exit: 0 clean  1 findings  2 usage  6 blind

set -uo pipefail

SELF_NAME='cloture'
VERSION='2026-09-07'

BUILD="${VERB_BUILD_DIR:-$HOME/.local/share/verb-builds/current}"
HOME_COMMANDS="${CLAUDE_COMMANDS_DIR:-$HOME/.claude/commands}"
PROJECTS_ROOT="${CLAUDE_PROJECTS_ROOT:-$HOME/.claude/projects}"

findings=0
blind=0

row() { findings=$((findings + 1)); printf '%-22s %s\n' "$1" "$2"; }
note() { printf '  %s\n' "$1"; }
say()  { printf '%s\n' "$1"; }
blind_row() { blind=1; printf '%-22s %s\n' "BLIND" "$1"; }

usage() {
  cat <<'EOF'
usage:
  cloture                 every check; 0 when clean, 1 when it found something
  cloture blocked         only what this session leaves waiting on a person
  cloture --json          the same rows, one JSON object per line
  cloture --help

Run it, act on the rows, run it again. The close is finished when it is CLEAN,
not when you have described why it is not.
EOF
}

# ---- built but not wired ---------------------------------------------------
# Three shapes, all of them measured on this host on 2026-09-07: a name on PATH
# that resolves into a clone, a command the build carries that no home has, and
# a command a home has that no source produces any more.

check_unwired() {
  say '## built but not wired'

  if command -v installe >/dev/null 2>&1; then
    local n t
    while IFS=$'\t' read -r n t; do
      [ -n "${n:-}" ] || continue
      case "$t" in
        */verb-builds/*) ;;
        "$HOME"/Documents/Projects/*)
          row 'CLONE-BACKED' "$n resolves into a clone, not the build -- $t"
          note 'it stops working the day that checkout goes' ;;
      esac
    done < <(installe list 2>/dev/null)
  else
    blind_row 'installe is not on PATH; cannot audit what a prompt can reach'
  fi

  if [ -d "$BUILD" ] && [ -d "$HOME_COMMANDS" ]; then
    local f b
    for f in "$BUILD"/*/commands/*.md; do
      [ -e "$f" ] || continue
      b="$(basename "$f")"
      [ -e "$HOME_COMMANDS/$b" ] || row 'BUILT-NOT-INSTALLED' "$b is in the build and in no home"
    done
    for f in "$HOME_COMMANDS"/*.md; do
      [ -e "$f" ] || continue
      b="$(basename "$f")"
      compgen -G "$BUILD/*/commands/$b" >/dev/null 2>&1 \
        || row 'INSTALLED-NOT-BUILT' "$b is reachable from a prompt and no build produces it"
    done
  else
    blind_row "no build at $BUILD or no commands dir at $HOME_COMMANDS"
  fi

  # NOT CHECKED HERE: whether a script declares `# KIND:` and so survives the
  # build. bin/verb-kind-lint.sh already owns that question and the suites run
  # it. A second implementation would be the exact thing this file exists to
  # catch -- a surface added while the one it duplicates stays.
}

# ---- raised but not filed --------------------------------------------------
# NOT A KEYWORD SCAN. hf7y/realisateur#165 is explicit that the rule is
# structural and not lexical -- the close that prompted it said "Not something
# I fixed -- flagging it", which contains none of the obvious trigger words. A
# regex over this session's own transcript was written first and matched 0 of
# 239 assistant messages, so it would have reported CLEAN on the session that
# raised four defects. It is gone.
#
# What is structural: an issue nobody can dispatch to was not filed, it was
# typed. Since 2026-09-04 a project runs only while a milestone holds an open
# issue, so an unmilestoned issue is absent from the queue however well written
# it is. That is checkable, and it is the state hf7y/bibliothecaire#93 is in.

session_transcript() {
  local sid="${CLAUDE_CODE_SESSION_ID:-}"
  [ -n "$sid" ] || return 1
  find "$PROJECTS_ROOT" -maxdepth 2 -name "$sid.jsonl" -print -quit 2>/dev/null | grep .
}

session_issues() {
  local t
  t="$(session_transcript)" || return 1
  grep -ohE 'github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[0-9]+' "$t" 2>/dev/null \
    | sed 's|.*github\.com/||' | sort -u
}

check_unfiled() {
  say ''
  say '## raised but not filed'

  command -v gh >/dev/null 2>&1 || { blind_row 'gh is not on PATH'; return; }
  session_transcript >/dev/null || { blind_row 'no transcript for this session'; return; }

  local slug repo num ms seen=0
  while read -r slug; do
    [ -n "$slug" ] || continue
    repo="${slug%/issues/*}"; num="${slug##*/}"
    seen=$((seen + 1))
    ms="$(gh issue view "$num" -R "$repo" --json state,milestone \
          --jq 'select(.state=="OPEN") | (.milestone.title // "NONE")' 2>/dev/null)" || continue
    [ "$ms" = 'NONE' ] && {
      row 'OPEN-NO-MILESTONE' "$repo#$num is open and in no milestone; nothing dispatches to it"
    }
  done < <(session_issues)

  [ "$seen" -eq 0 ] && note 'this session referenced no issue'
}

# ---- layered not replaced --------------------------------------------------
# Adding a fourth surface where three exist. The tell that is actually
# measurable is a commit that only adds: new files, nothing retired, prose up.

check_layered() {
  say ''
  say '## layered not replaced'

  git rev-parse --git-dir >/dev/null 2>&1 || { blind_row 'not inside a git repository'; return; }

  local base added removed
  base="$(git merge-base origin/main HEAD 2>/dev/null)" || base=''
  if [ -z "$base" ]; then
    blind_row 'no origin/main to compare against'
    return
  fi

  # Committed AND uncommitted. A new file that is still only in the working
  # tree is the commonest way this check reports clean on a session that
  # layered -- it was, on the run that first exercised this file.
  local add_list rm_list
  add_list="$( { git diff --diff-filter=A --name-only "$base"..HEAD 2>/dev/null
                 git status --porcelain 2>/dev/null | sed -n 's/^?? //p'
                 git diff --cached --diff-filter=A --name-only 2>/dev/null
               } | grep -E '\.(md|sh|tsv)$|^bin/[a-z-]+$' | sort -u )"
  rm_list="$( { git diff --diff-filter=D --name-only "$base"..HEAD 2>/dev/null
                git status --porcelain 2>/dev/null | sed -n 's/^ D //p'
              } | sort -u )"

  added="$(printf '%s' "$add_list" | grep -c . || true)"
  removed="$(printf '%s' "$rm_list" | grep -c . || true)"

  if [ "${added:-0}" -gt 0 ] && [ "${removed:-0}" -eq 0 ]; then
    row 'ADDED-NOTHING-RETIRED' "$added new file(s) since origin/main, 0 retired"
    note 'name what each replaces, or say why the thing it duplicates stays'
    printf '%s\n' "$add_list" | sed 's/^/    /'
  fi
}

# ---- branches --------------------------------------------------------------
# `git cherry` is the wrong test on its own: squash-merges and reworks change
# patch-ids, so it reports unique commits for branches whose content landed.
# Six for six on 2026-09-07. Ask instead whether merging would change anything.

check_branches() {
  say ''
  say '## branches'

  git rev-parse --git-dir >/dev/null 2>&1 || { blind_row 'not inside a git repository'; return; }

  local stale
  stale="$(git worktree list --porcelain 2>/dev/null | grep -c '^prunable' || true)"
  [ "${stale:-0}" -gt 0 ] && row 'PRUNABLE-WORKTREES' \
    "$stale worktree record(s) whose directory is gone -- each one pins its branch"

  [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ] && \
    row 'UNCOMMITTED' 'tracked changes in the working tree'

  # Untracked and not ignored: it will sit in `git status` forever and belongs
  # to nobody. On 2026-09-07 a 12MB PostScript file named `json` sat in this
  # repo's root and the close reported it in prose rather than dealing with it.
  local u n
  u="$(git status --porcelain --untracked-files=all 2>/dev/null | sed -n 's/^?? //p')"
  n="$(printf '%s' "$u" | grep -c . || true)"
  if [ "${n:-0}" -gt 0 ]; then
    row 'UNTRACKED' "$n path(s) untracked and not ignored"
    note 'commit, ignore, or move it out -- reporting it is not dealing with it'
    printf '%s\n' "$u" | head -10 | sed 's/^/    /'
  fi

  local b n
  while read -r b; do
    [ -n "$b" ] || continue
    [ "$b" = 'main' ] && continue
    n="$(git diff --stat origin/main.."$b" 2>/dev/null | wc -l)"
    [ "${n:-0}" -eq 0 ] && { row 'MERGED-NOT-REAPED' "$b would change nothing; reap it"; continue; }
    command -v gh >/dev/null 2>&1 || continue
    gh pr list --head "$b" --state open --json number --jq '.[0].number' 2>/dev/null | grep -q . \
      || row 'NO-PR' "$b has content and no open PR"
  done < <(git branch --format='%(refname:short)' 2>/dev/null)
}

# ---- blocked on a person ---------------------------------------------------
# Scoped to this session on purpose. What is piled up estate-wide is a
# different question with its own surface; answering it here would be a fourth.

check_blocked() {
  say ''
  say '## blocked on a person, from this session'

  command -v gh >/dev/null 2>&1 || { blind_row 'gh is not on PATH'; return 0; }
  session_transcript >/dev/null || { blind_row 'no transcript for this session'; return 0; }

  # Line 1 of a body is DECISION: or NO-DECISION: -- the grammar gh-sign
  # enforces at the write. Only the first is waiting on a person.
  local slug repo num out seen=0
  while read -r slug; do
    [ -n "$slug" ] || continue
    repo="${slug%/issues/*}"; num="${slug##*/}"
    out="$(gh issue view "$num" -R "$repo" --json state,body,title \
           --jq 'select(.state=="OPEN") | select(.body | startswith("DECISION:")) | .title' 2>/dev/null)" || continue
    [ -n "$out" ] || continue
    seen=$((seen + 1))
    row 'AWAITING-A-PERSON' "$repo#$num -- ${out:0:64}"
  done < <(session_issues)

  [ "$seen" -eq 0 ] && note 'nothing this session touched declares DECISION: and is still open'
  return 0
}

# ---- main ------------------------------------------------------------------

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --version) printf '%s %s\n' "$SELF_NAME" "$VERSION"; exit 0 ;;
  blocked)   check_blocked
             [ "$blind" -eq 1 ] && exit 6
             [ "$findings" -gt 0 ] && exit 1 || exit 0 ;;
  ''|--json) ;;
  *)         printf '%s: unknown argument %s\n' "$SELF_NAME" "$1" >&2; usage >&2; exit 2 ;;
esac

check_unwired
check_unfiled
check_layered
check_branches
check_blocked

say ''
if [ "$findings" -eq 0 ] && [ "$blind" -eq 0 ]; then
  say 'CLEAN -- nothing raised, layered or built-and-unreached. The close is done.'
  exit 0
fi
say "$findings finding(s). Act on them, then run cloture again; a close ends CLEAN."
[ "$blind" -eq 1 ] && say 'At least one check could not look. That is not a pass.'
exit 1

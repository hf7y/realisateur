#!/usr/bin/env bash
# epluche -- scrutinize the tree for hygiene defects
#
# A plain shell utility. It costs nothing to run and reaches no paid service.
# Parted off from the monolith verb 2026-07-30 (one noun, many verbs): this
# verb owns one coherent domain. A subcommand backed by a script execs it; one
# with nothing behind it reports GAP (exit 4), never an exit-0 no-op.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=epluche
VERB_SUMMARY="scrutinize the tree for hygiene defects"
VERB_USAGE="epluche <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

LEGACY_ROOT="${EPLUCHE_LEGACY_ROOT:-/home/zach/Documents/Projects/realisateur}"

verb_subcommands() {
  printf '%s\n' \
    'hygiene-lint                 build-hygiene scan across projects' \
    'closeout-lint                what did a session leave behind' \
    'reach-lint                   can the executor reach what a command names' \
    'silence-audit                the stderr-silencing null-discriminator' \
    ''
}

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands:\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`man %s` for the contract)\n' "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  hygiene-lint)
    [ -x "$LEGACY_ROOT/bin/hygiene-lint.sh" ] || verb_gap 'hygiene-lint: bin/hygiene-lint.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/hygiene-lint.sh" "$@" ;;
  closeout-lint)
    [ -x "$LEGACY_ROOT/bin/closeout-lint.sh" ] || verb_gap 'closeout-lint: bin/closeout-lint.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/closeout-lint.sh" "$@" ;;
  reach-lint)
    [ -x "$LEGACY_ROOT/bin/reach-lint.sh" ] || verb_gap 'reach-lint: bin/reach-lint.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/reach-lint.sh" "$@" ;;
  silence-audit)
    [ -x "$LEGACY_ROOT/bin/silence-audit.sh" ] || verb_gap 'silence-audit: bin/silence-audit.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/silence-audit.sh" "$@" ;;
  *) verb_gap "unknown subcommand: $cmd (try \`list\`)" ;;
esac

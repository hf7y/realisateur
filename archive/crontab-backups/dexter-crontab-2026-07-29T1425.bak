# PATH added 2026-07-28 (realisateur /ideate). cron gives only /usr/bin:/bin,
# and ~/.bashrc returns early for non-interactive shells BEFORE its nvm block
# (line 120), so node/npm were invisible to every scheduled job. ~/.local/bin
# holds symlinks to the nvm default node. Remove this line to revert.
PATH=/home/zach/.local/bin:/usr/local/bin:/usr/bin:/bin
# >>> scheduler-managed (dexter) -- installed by hand 2026-07-24, NOT by
# bin/sync-crontab.sh: that script derives the whole crontab from schedule/*.conf,
# which describes MANDARK's projects (it would install fixed-cron lines for
# groc-mangr/nine-speakers/sequestria/vim-arcade and a sweep tick, none of which
# have repos on this host). Making sync-crontab.sh host-scoped is an open item.
# The line below is derived from schedule/_runner.conf, not retyped.
*/30 * * * * PACED_MAX_PER_TICK=1 /home/zach/.local/bin/usage-paced-runner.sh # scheduler:scheduler-paced-runner:RUNNER (usage-paced dispatch, dexter)
# <<< scheduler-managed (dexter) <<<

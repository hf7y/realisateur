#!/usr/bin/env bash
# fitness -- score a worker from the office's real ledger.
#
#   fitness <login> [--ledger PATH] [--json]
#   fitness --all    [--ledger PATH] [--json]
#
# Reads the append-only ledger (id|ts|account|type|amount|_|hash|note, pegged
# 10000 tokens/wavebuck) and computes a worker's fitness from what it actually
# did, not what it says. Pure computation -- no agent, no tokens. Output is
# line-oriented and quiet: one `login score=… …` line per worker on stdout,
# nothing else, so it pipes into `sort`/`evolve`.
#
# Ledger path: --ledger, else $OFFICE_LEDGER, else the nomac default.
#
# Exit: 0 scored; 2 usage; 6 BLIND (ledger unreadable -- NOT "score 0", because
# "I cannot see the ledger" must never read as "this worker did nothing").
set -uo pipefail

LEDGER="${OFFICE_LEDGER:-$HOME/office-state/ledger/ledger.psv}"
WHO=""; ALL=0; JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ledger) LEDGER="${2:-}"; shift 2 ;;
    --all) ALL=1; shift ;;
    --json) JSON=1; shift ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) printf 'fitness: unknown flag: %s\n' "$1" >&2; exit 2 ;;
    *) [ -z "$WHO" ] && WHO="$1" || { printf 'fitness: one login at a time\n' >&2; exit 2; }; shift ;;
  esac
done
[ "$ALL" -eq 1 ] || [ -n "$WHO" ] || { printf 'fitness: a <login> or --all is required\n' >&2; exit 2; }
[ -r "$LEDGER" ] || { printf 'fitness: BLIND: ledger unreadable at %s\n' "$LEDGER" >&2; exit 6; }

# The model, stated so the number is legible rather than magic:
#   credited  = wavebucks the account RECEIVED  (HIRE, EARN, POST-in, APPROP)
#   debited   = wavebucks it SPENT              (RENT, SPEND, POST-out, FEE)
#   balance   = credited - debited
#   tenure    = ledger rows the account appears in (proxy for ticks survived)
#   activity  = non-RENT debits it initiated (it DID things, not just paid rent)
#   fitness   = balance + activity, floored at nothing special -- a worker that
#               only pays metabolism and earns nothing trends negative, which is
#               exactly the selection pressure evolve reads.
# CREDIT/DEBIT sets are named here and nowhere else so the sign convention has
# one source. If the office adds a transaction type, it is added here.
score_one() { # <login>
  awk -F'|' -v who="$1" -v json="$JSON" '
    BEGIN{
      split("HIRE EARN APPROP BONUS", C, " "); for(i in C) credit[C[i]]=1
      split("RENT SPEND FEE POST", D, " "); for(i in D) debit[D[i]]=1
    }
    $3==who {
      seen++
      amt=$5+0
      if ($4 in credit) cred+=amt
      else if ($4 in debit) { deb+=amt; if ($4!="RENT") act++ }
    }
    END{
      bal=cred-deb
      fit=bal+act
      if (!seen) { print who" score=NA seen=0 (never appears in ledger)"; exit 3 }
      if (json)
        printf "{\"login\":\"%s\",\"score\":%d,\"balance\":%d,\"credited\":%d,\"debited\":%d,\"activity\":%d,\"tenure\":%d}\n", who, fit, bal, cred, deb, act, seen
      else
        printf "%s score=%d balance=%d credited=%d debited=%d activity=%d tenure=%d\n", who, fit, bal, cred, deb, act, seen
    }
  ' "$LEDGER"
}

if [ "$ALL" -eq 1 ]; then
  # every distinct account except the system rails (treasury/genesis), highest
  # fitness first -- the exact input evolve wants.
  accounts="$(awk -F'|' 'NR>1 && $3!="office" && $3!="TREASURY"{print $3}' "$LEDGER" | sort -u)"
  [ -n "$accounts" ] || { printf 'fitness: no worker accounts in ledger\n' >&2; exit 0; }
  { while IFS= read -r a; do [ -n "$a" ] && score_one "$a"; done <<< "$accounts"; } \
    | sort -t= -k2 -rn
else
  score_one "$WHO"
fi

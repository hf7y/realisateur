#!/usr/bin/env bash
# evolve -- the selection step: rank workers by fitness, keep the fit, retire
# the unfit, and propose the next generation by recombining survivors' traits.
#
#   evolve [--ledger L] [--workers DIR] [--survivors N] [--seed S] [--json]
#
# Deterministic under --seed -- no agent, no tokens. Reads `fitness --all`
# (real ledger) and the worker records `persona` wrote. Emits a line-oriented
# selection report on stdout: KEEP / RETIRE / HIRE, one decision per line, so it
# pipes into whatever provisions and seals accounts.
#
# The evolutionary claim it makes testable: if a trait correlates with fitness
# (industrious workers take more commissiones -> more EARN credits), that trait
# rises in the population across generations, because HIRE recombines the
# survivors and the survivors are selected on fitness. Nothing here asserts WHICH
# trait wins -- that is the experiment, and it is legible because every step is
# arithmetic.
#
# Exit: 0 ok; 2 usage; 6 BLIND (can't read ledger or worker dir).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

LEDGER="${OFFICE_LEDGER:-$HOME/office-state/ledger/ledger.psv}"
WORKER_DIR="${OFFICE_WORKERS:-$HOME/office-state/workers}"
SURV=0; SEED=1; JSON=0
while [ $# -gt 0 ]; do case "$1" in
  --ledger) LEDGER="${2:-}"; shift 2 ;;
  --workers) WORKER_DIR="${2:-}"; shift 2 ;;
  --survivors) SURV="${2:-}"; shift 2 ;;
  --seed) SEED="${2:-}"; shift 2 ;;
  --json) JSON=1; shift ;;
  -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) printf 'evolve: unexpected: %s\n' "$1" >&2; exit 2 ;;
esac; done
[ -d "$WORKER_DIR" ] || { printf 'evolve: BLIND: worker dir unreadable at %s\n' "$WORKER_DIR" >&2; exit 6; }

# ranked living workers (highest fitness first), from the real ledger
ranked="$("$HERE/fitness" --all --ledger "$LEDGER" 2>/dev/null | awk '{print $1}')"
[ -n "$ranked" ] || { printf 'evolve: no scored workers -- nothing to select on\n' >&2; exit 0; }
mapfile -t ORDER <<< "$ranked"
n="${#ORDER[@]}"
# default: upper half survive (at least one), rounded up
[ "$SURV" -gt 0 ] 2>/dev/null || SURV=$(( (n + 1) / 2 ))
[ "$SURV" -gt "$n" ] && SURV="$n"

# seeded RNG (same discipline as persona: global, never $()-wrapped)
_st="$SEED"; next(){ _st=$(((1103515245*_st+12345)&0x7fffffff)); RND=$_st; }
trait(){ awk -F= -v k="$2" '$1==k{print $2}' "$WORKER_DIR/$1.worker" 2>/dev/null; }

emit(){ [ "$JSON" -eq 1 ] && printf '{"decision":"%s","login":"%s","detail":"%s"}\n' "$1" "$2" "$3" \
        || printf '%-6s %-16s %s\n' "$1" "$2" "$3"; }

survivors=(); i=0
for login in "${ORDER[@]}"; do
  if [ "$i" -lt "$SURV" ]; then survivors+=("$login"); emit KEEP "$login" "rank $((i+1))/$n"
  else emit RETIRE "$login" "rank $((i+1))/$n -- below the fitness line"; fi
  i=$((i+1))
done

# next generation: one child per retiree, recombining two survivors. A child's
# trait is the mean of two parents plus a bounded mutation, then clamped 0..100.
# Recombining the SURVIVORS is what makes fitness heritable.
TRAITS=(industriousness thoroughness frugality risk_tolerance sociability curiosity)
retirees=$(( n - SURV ))
[ "${#survivors[@]}" -ge 1 ] || exit 0
for ((c=0; c<retirees; c++)); do
  next; pa="${survivors[$(( RND % ${#survivors[@]} ))]}"
  next; pb="${survivors[$(( RND % ${#survivors[@]} ))]}"
  child="scion$((c+1))"
  line=""
  for t in "${TRAITS[@]}"; do
    va="$(trait "$pa" "$t")"; vb="$(trait "$pb" "$t")"; va="${va:-50}"; vb="${vb:-50}"
    next; mut=$(( (RND % 21) - 10 ))                 # +/-10 mutation
    v=$(( (va + vb) / 2 + mut )); [ "$v" -lt 0 ] && v=0; [ "$v" -gt 100 ] && v=100
    line="$line $t=$v"
  done
  emit HIRE "$child" "from ${pa}x${pb}:$line"
done

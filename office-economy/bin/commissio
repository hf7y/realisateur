#!/usr/bin/env bash
# commissio -- the bounty board, and the office's decision-economizer.
#
#   commissio post <title> <reward> <acceptance-test> [--as WHO] [--expiry YYYY-MM-DD]
#   commissio list [--open]
#   commissio match <login> [--worker DIR]
#   commissio settle <id> <login>
#
# THE POINT (see README): `match` replaces an agent asking "what should I work
# on?" -- an open-ended, token-priced deliberation -- with a deterministic
# filter of the worker's PERSONALITY against the open board. The traits ARE the
# decision procedure; no model is in the loop to choose work. That is the
# pre-built means of economizing agent decision-making.
#
# Board: $OFFICE_COMMISSIONES (default under office-state), pipe-separated:
#   id|title|reward|acceptance|expiry|status|creator|assignee
# Worker records: <worker-dir>/<login>.worker (key=value, from `persona`).
#
# Line-oriented, quiet by default. Exit: 0 ok; 2 usage; 6 BLIND (board
# unreadable); 4 no such commissio/worker.
set -uo pipefail

BOARD="${OFFICE_COMMISSIONES:-$HOME/office-state/commissiones.psv}"
WORKER_DIR="${OFFICE_WORKERS:-$HOME/office-state/workers}"

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }
die2() { printf 'commissio: %s\n' "$*" >&2; exit 2; }
ensure_board() { [ -f "$BOARD" ] || { mkdir -p "$(dirname "$BOARD")" && : > "$BOARD"; }; }

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  -h|--help|'') usage; exit 0 ;;

  post)
    AS="anon"; EXP="-"
    args=()
    while [ $# -gt 0 ]; do case "$1" in
      --as) AS="${2:-}"; shift 2 ;;
      --expiry) EXP="${2:-}"; shift 2 ;;
      -*) die2 "post: unknown flag: $1" ;;
      *) args+=("$1"); shift ;;
    esac; done
    [ "${#args[@]}" -eq 3 ] || die2 "post: need <title> <reward> <acceptance-test>"
    title="${args[0]}"; reward="${args[1]}"; acc="${args[2]}"
    [[ "$reward" =~ ^[0-9]+$ ]] || die2 "post: reward must be a non-negative integer (wavebucks)"
    case "$title$acc" in *"|"*) die2 "post: title/acceptance must not contain '|' (the field separator)";; esac
    ensure_board
    id=$(( $(awk -F'|' 'END{print NR+0}' "$BOARD") + 1 ))
    printf '%s|%s|%s|%s|%s|OPEN|%s|-\n' "$id" "$title" "$reward" "$acc" "$EXP" "$AS" >> "$BOARD"
    # Escrow is a director/ledger action, not this tool's to fake. State it.
    printf 'commissio: posted #%s (reward %s wb). Escrow of %s from %s is a ledger action, not done here.\n' \
      "$id" "$reward" "$reward" "$AS" >&2
    printf '%s\n' "$id"   # stdout = the id, so `post` pipes
    ;;

  list)
    [ -r "$BOARD" ] || { printf 'commissio: BLIND: board unreadable at %s\n' "$BOARD" >&2; exit 6; }
    only_open=0; [ "${1:-}" = "--open" ] && only_open=1
    awk -F'|' -v oo="$only_open" '
      NF>=8 { if (oo && $6!="OPEN") next
        printf "%s\t%s\treward=%s\tstatus=%s\t%s\n", $1, $2, $3, $6, ($8=="-"?"":"@"$8) }' "$BOARD"
    ;;

  match)
    login="${1:-}"; shift || true
    [ -n "$login" ] || die2 "match: a <login> is required"
    while [ $# -gt 0 ]; do case "$1" in --worker) WORKER_DIR="${2:-}"; shift 2;; *) die2 "match: unexpected: $1";; esac; done
    wf="$WORKER_DIR/$login.worker"
    [ -r "$wf" ] || { printf 'commissio: no worker record for %s at %s\n' "$login" "$wf" >&2; exit 4; }
    [ -r "$BOARD" ] || { printf 'commissio: BLIND: board unreadable at %s\n' "$BOARD" >&2; exit 6; }
    # read the traits this worker decides with
    ind=$(awk -F= '/^industriousness=/{print $2}' "$wf")
    fru=$(awk -F= '/^frugality=/{print $2}' "$wf")
    rsk=$(awk -F= '/^risk_tolerance=/{print $2}' "$wf")
    # THE DECISION PROCEDURE, deterministic, no model:
    #   reward bar rises with frugality (a frugal worker demands more pay) and
    #     falls with industriousness (a busy worker takes cheaper work).
    #   a vague acceptance test (short) is only taken by the risk-tolerant.
    # Every constant here is a knob, named, not magic. Tuning them is a diff.
    awk -F'|' -v ind="$ind" -v fru="$fru" -v rsk="$rsk" -v me="$login" '
      NF>=8 && $6=="OPEN" && ($8=="-" || $8==me) {
        reward=$3+0; acc=$4; acclen=length(acc)
        bar = (fru*0.4) - (ind*0.2)            # frugal raises, industrious lowers
        if (bar < 0) bar = 0
        vague = (acclen < 24)                  # short acceptance test = underspecified
        if (reward < bar) next                 # not worth it to this worker
        if (vague && rsk < 50) next            # too risky for the risk-averse
        # a fit: emit, with why, ranked by reward
        printf "%s\t%s\treward=%s\tfit=take\t(bar=%d%s)\n", $1, $2, reward, bar, (vague?",vague":"")
      }' "$BOARD" | sort -t= -k2 -rn
    ;;

  settle)
    id="${1:-}"; login="${2:-}"
    { [ -n "$id" ] && [ -n "$login" ]; } || die2 "settle: need <id> <login>"
    [ -w "$BOARD" ] || { printf 'commissio: BLIND: board not writable at %s\n' "$BOARD" >&2; exit 6; }
    awk -F'|' -v id="$id" 'BEGIN{f=0} $1==id{f=1} END{exit !f}' "$BOARD" || { printf 'commissio: no such commissio #%s\n' "$id" >&2; exit 4; }
    tmp="$(mktemp)"
    awk -F'|' -v OFS='|' -v id="$id" -v who="$login" '
      $1==id { if ($6!="OPEN"){print "commissio: #"id" is not OPEN (is "$6")" > "/dev/stderr"; exit 5}
               $6="DONE"; $8=who } {print}' "$BOARD" > "$tmp" && mv "$tmp" "$BOARD"
    printf 'commissio: #%s settled to %s. Reward payout is a ledger action.\n' "$id" "$login" >&2
    printf '%s\n' "$id"
    ;;

  *) die2 "unknown subcommand: $cmd" ;;
esac

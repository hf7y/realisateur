#!/usr/bin/env bash
# bashify -- state a project's promise as a contract a shell can hold.
#
# This is the front door described by man/bashify.1. The page was written
# first; this file exists to make the page true. Three of its four
# subcommands are not built, and this file's job is to say so at exit 4
# rather than let the page describe something that silently does nothing.
#
# Read the page, not this header: `man -l man/bashify.1`.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=bashify
VERB_SUMMARY="state a project's promise as a contract a shell can hold"
VERB_USAGE="bashify <subcommand> [args...]   (list, emit, page, check, amend)"
# Reversed 2026-07-30. bashify spends, through one front door. Animacy in this
# ecosystem means carrying an agenda -- a loop of one's own -- not touching a
# model: a verb that summons at a call site is not carrying an agent, it is
# calling one. Law 3 forbids the former and says nothing against the latter.
VERB_CAN_SUMMON=1
VERB_SUMMON_COST="unmeasured; metered by the contract store, printed before spending"
# shellcheck source=../skel/lib/verb.sh
. "$SELF/skel/lib/verb.sh"

# The one place the implementation of `emit` is named.
EMIT_IMPL="$SELF/bashify.sh"
CHECK_IMPL="$SELF/lib/check.sh"
AMEND_IMPL="$SELF/lib/amend.sh"
# The contract store. bashify is the front door; this is what stands behind it
# when a promise cannot be kept mechanically.
STORE="/home/zach/Documents/Projects/basheur/bin/basheur"
SCHED="/home/zach/Documents/Project Archive/scheduler"

# Subcommands that can spend. Named here so `--summon` on anything else is a
# usage error rather than a flag that quietly does nothing.
_spends() { case "$1" in page) return 0 ;; *) return 1 ;; esac; }

# state <sub> -- MECHANIZED iff something real is behind it. Derived from the
# filesystem, not typed, so a subcommand cannot claim to be built by assertion.
_state() {
  case "$1" in
    list)          echo MECHANIZED ;;
    emit)          [ -x "$EMIT_IMPL" ] && echo MECHANIZED || echo GAP ;;
    check)         [ -x "$CHECK_IMPL" ] && echo MECHANIZED || echo GAP ;;
    amend)         [ -x "$AMEND_IMPL" ] && echo MECHANIZED || echo GAP ;;
    # Not GAP. GAP means no tooling AND no escalation; page has an escalation
    # now that bashify can spend, so it is a metered promise, not a missing one.
    page)          [ -x "$STORE" ] && echo SUMMON || echo GAP ;;
  esac
}

_say() { [ "$VERB_QUIET" = 1 ] || printf '%s\n' "$*"; }

# --json is honoured by `list` alone. Anywhere else it is REFUSED, never
# dropped: a silently ignored flag is a caller who asked for one thing,
# received another, and was told nothing.
_no_json() { [ "$VERB_JSON" = 1 ] && verb_gap '--json: not wired for this subcommand'; return 0; }

# A leading flag is a flag, not a subcommand. Taking `--version` as a
# subcommand name made it exit 2 while the page documented it working, which
# is a row-3 failure the page test caught: `bashify --json` must reach `list`,
# and `bashify --not-real` must reach the unknown-flag error, not this case
# statement's catch-all.
case "${1:-}" in
  -*) cmd=list ;;
  *)  cmd="${1:-list}"; [ $# -gt 0 ] && shift ;;
esac
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

# --summon authorises spending. It does not request an act. Passing it with no
# act attached must fail: a cost flag that exits 0 having done nothing is an
# implicit spend wearing a no-op, which is the exact pair this ecosystem
# records more than any other.
if [ "$VERB_SUMMON" = 1 ] && ! _spends "$cmd"; then
  verb_die "--summon authorises spending, but '$cmd' never spends. No act was requested."
fi

case "$cmd" in
  list)
    if [ "$VERB_JSON" = 1 ]; then
      printf '['
      _sep=''
      for s in amend check emit list page; do
        printf '%s{"subcommand":"%s","state":"%s"}' "$_sep" "$s" "$(_state "$s")"; _sep=','
      done
      printf ']\n'
    else
      for s in amend check emit list page; do
        printf '%-13s %s\n' "$(_state "$s")" "$s"
      done
    fi
    ;;

  emit)
    _no_json
    [ $# -eq 3 ] || verb_die "emit takes exactly 3 arguments: <project> <verb> <summary> (got $#)"
    proj="$1"; verb="$2"; summary="$3"
    # Preconditions are checked HERE so a caller error exits 2. Past this
    # point the arguments are valid, so any failure is a broken promise (5),
    # never a usage error wearing a different number.
    [ -f "$SCHED/schedule/$proj.conf" ] \
      || verb_die "emit: no registered project named '$proj'"
    case "$verb" in
      *[!a-z]*) verb_die "emit: verb '$verb' must be lowercase ASCII letters only" ;;
    esac
    if command -v "$verb" >/dev/null 2>&1; then
      verb_die "emit: '$verb' is already claimed on PATH; coin another"
    fi
    [ -x "$EMIT_IMPL" ] || verb_gap "emit: implementation missing at $EMIT_IMPL"
    _say "bashify: emitting $proj -> $verb"
    "$EMIT_IMPL" "$proj" "$verb" "$summary"
    rc=$?
    [ "$rc" = 0 ] || verb_broke "emit: the branch for '$proj' was not produced (implementation exit $rc)"
    ;;

  page)
    _no_json
    [ $# -eq 2 ] || verb_die "page takes exactly 2 arguments: <verb> <command> (got $#)"
    # Writing a page is judgment: it states a promise nothing yet keeps, so
    # there is no mechanical source to derive it from. That is what a summon
    # is for, and it is refused rather than spent without one.
    verb_need_summon "writing a man page states a promise no tool yet keeps; that is judgment, not lookup"
    [ -x "$STORE" ] || verb_broke "the contract store is missing at $STORE"
    "$STORE" run --summon verb-page "$1" "$2"
    rc=$?
    case "$rc" in
      0) ;;
      4) verb_gap "page: the contract store has no 'verb-page' contract; nothing can write this yet" ;;
      *) verb_broke "page: the contract store failed (exit $rc)" ;;
    esac
    ;;

  check)
    _no_json
    [ $# -eq 2 ] || verb_die "check takes exactly 2 arguments: <page> <command> (got $#)"
    [ -x "$CHECK_IMPL" ] || verb_gap "check: implementation missing at $CHECK_IMPL"
    "$CHECK_IMPL" "$1" "$2"
    exit $?
    ;;

  amend)
    _no_json
    [ $# -eq 2 ] || verb_die "amend takes exactly 2 arguments: <page> <reason> (got $#)"
    [ -x "$AMEND_IMPL" ] || verb_gap "amend: implementation missing at $AMEND_IMPL"
    "$AMEND_IMPL" "$1" "$2"
    exit $?
    ;;

  help|--help|-h) verb_usage ;;
  *) verb_die "unknown subcommand: $cmd  (try: bashify list)" ;;
esac
